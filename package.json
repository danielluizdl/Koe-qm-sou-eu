{
  "name": "quem-sou-eu",
  "version": "0.2.0",
  "private": true,
  "description": "Jogo de adivinhar quem você é, para jogar com os amigos na mesma mesa.",
  "scripts": {
    "build": "node build.js",
    "test": "node test-tudo.js",
    "dev": "node build.js && npx firebase emulators:start",
    "deploy": "node build.js && npx firebase deploy",
    "deploy:regras": "npx firebase deploy --only firestore:rules",
    "deploy:site": "node build.js && npx firebase deploy --only hosting",
    "test:regras": "firebase emulators:exec --only firestore --project demo-quem-sou-eu \"node test-regras.js\""
  },
  "dependencies": {
    "firebase": "^12.18.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.29.0"
  }
}

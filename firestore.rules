rules_version = '2';

/* ============================================================
   REGRAS DE SEGURANÇA — Quem Sou Eu

   TESTADAS: test-regras.js, contra o emulador.
       npm run test:regras
   Os testes são escritos da posição do atacante: cada um tenta fazer
   algo que NÃO deveria ser possível e falha se conseguir. Provar só o
   caminho feliz mostraria que o jogo funciona, não que ele protege.

   PRINCÍPIO: o cliente é hostil. Todo jogador pode abrir o console
   do navegador e chamar o Firestore direto, sem passar pelo jogo.
   Então nada que importa pode depender do código do cliente —
   sobretudo o saldo do rank.

   O jogador é identificado pelo `request.auth.uid` do Firebase Auth
   (CriarSalaCliente recebe a identidade). Sem isso não haveria o que
   verificar: um uuid gerado no aparelho não prova nada.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function logado()      { return request.auth != null; }
    function eu(uid)       { return logado() && request.auth.uid == uid; }
    function agora()       { return request.time.toMillis(); }
    function campos()      { return request.resource.data; }
    function anterior()    { return resource.data; }
    function mudou(cs)     { return campos().diff(anterior()).affectedKeys().hasOnly(cs); }

    /* `resource` é null quando o documento ainda não existe. Toda
       leitura do estado anterior passa por aqui antes de tocar em
       resource.data.

       NOTA sobre o log do emulador: mesmo com esta guarda, rodar os
       testes ainda imprime "evaluation error at L..." para escritas em
       documentos que não existem. É o avaliador verboso do emulador
       percorrendo a árvore inteira da expressão para montar o
       diagnóstico — não uma negação errada. O que importa está coberto:
       os casos que DEVEM ser permitidos passam (assertSucceeds) e os
       que devem ser negados são negados (assertFails), todos em
       test-regras.js. Não persiga essas linhas no log achando que são
       bug; olhe o resultado do suite. */
    function existia()     { return resource != null; }

    /* Idem para get(): buscar um documento inexistente estoura. O
       exists() antes custa uma leitura do orçamento da regra (o limite
       é 10 por requisição; aqui usamos 2) e troca o estouro por um
       false honesto. */
    function souHostDa(codigo) {
      return logado()
          && exists(/databases/$(database)/documents/salas/$(codigo))
          && get(/databases/$(database)/documents/salas/$(codigo)).data.hostId
             == request.auth.uid;
    }

    /* Ranking geral sem Cloud Function (ver LIMITE CONHECIDO no fim do
       arquivo): quem grava usuarios/{uid}/partidas/{pid} é o PRÓPRIO
       jogador, mas só se o que ele declara bater com o resultado que o
       HOST já gravou em salas/{sala}/hist/registro — essa é a fonte de
       verdade, o cliente não inventa o próprio saldo.

       Sem macro de lista (`.exists()`/`.filter()` não existem nas Rules
       do Firestore, só no CEL puro): o cliente informa em que ÍNDICE do
       array `resultados` está a própria linha, e a regra INDEXA direto
       pra conferir — bem mais barato que iterar, e o índice sozinho não
       prova nada (só ajuda a apontar onde olhar). */
    function resultadoBateComHist(sala, pid, uid, n, posicao, idx) {
      return exists(/databases/$(database)/documents/salas/$(sala)/hist/registro)
          && pid in get(/databases/$(database)/documents/salas/$(sala)/hist/registro).data.items
          && get(/databases/$(database)/documents/salas/$(sala)/hist/registro).data.items[pid].resultados.size() == n
          && idx >= 0 && idx < n
          && get(/databases/$(database)/documents/salas/$(sala)/hist/registro).data.items[pid].resultados[idx].id == uid
          && get(/databases/$(database)/documents/salas/$(sala)/hist/registro).data.items[pid].resultados[idx].posicao == posicao;
    }

    /* ---------------------------------------------------------
       perfis/{uid} — PÚBLICO pra quem está logado
       Nick e agregado do rank. Sem nada pessoal: é justamente por
       isso que a leitura pode ser aberta, e é o que permite montar
       o rank de amigos com uma leitura por amigo.
       --------------------------------------------------------- */
    match /perfis/{uid} {
      allow read: if logado();

      allow create: if eu(uid)
                    && campos().uid == uid
                    && campos().partidas == 0
                    && campos().saldo == 0
                    && campos().vitorias == 0
                    && campos().podios == 0
                    && campos().somaAprov == 0
                    && campos().anonimo == false;

      /* Duas formas de mexer no próprio perfil, sem misturar:
         1) nick/ID/flag de anônimo — o de sempre.
         2) somar UMA partida ao agregado do rank, e só depois de
            usuarios/{uid}/partidas/{ultimaPartidaId} já existir — essa
            escrita É a prova (create-only, cruzada com o hist da sala
            na própria regra dela). Sem Cloud Function pra fazer isso
            pelo Admin SDK (ver LIMITE CONHECIDO), incrementar +1 nessa
            ordem, amarrado a uma partida real, é o que sobra pra
            impedir "declarar saldo 999 do nada" pelo console. */
      allow update: if eu(uid) && existia()
                    && campos().uid == anterior().uid
                    && (
                      mudou(['nick','nickChave','id','anonimo','atualizadoEm'])
                      ||
                      ( mudou(['partidas','vitorias','podios','saldo','somaAprov','atualizadoEm','ultimaPartidaId'])
                        && campos().ultimaPartidaId is string
                        && exists(/databases/$(database)/documents/usuarios/$(uid)/partidas/$(campos().ultimaPartidaId))
                        && campos().partidas == anterior().partidas + 1
                        && campos().vitorias == anterior().vitorias
                           + (get(/databases/$(database)/documents/usuarios/$(uid)/partidas/$(campos().ultimaPartidaId)).data.posicao == 1 ? 1 : 0)
                        && campos().podios == anterior().podios
                           + (get(/databases/$(database)/documents/usuarios/$(uid)/partidas/$(campos().ultimaPartidaId)).data.posicao <= 3 ? 1 : 0)
                        && campos().saldo == anterior().saldo
                           + get(/databases/$(database)/documents/usuarios/$(uid)/partidas/$(campos().ultimaPartidaId)).data.saldo
                        && campos().somaAprov == anterior().somaAprov
                           + get(/databases/$(database)/documents/usuarios/$(uid)/partidas/$(campos().ultimaPartidaId)).data.aproveitamento
                      )
                    );

      /* Nunca some: salas são permanentes e o histórico depende dele.
         Encerrar conta ANONIMIZA (update), não apaga. */
      allow delete: if false;
    }

    /* ---------------------------------------------------------
       usuarios/{uid} — PRIVADO. Nome e e-mail, só o dono.
       --------------------------------------------------------- */
    match /usuarios/{uid} {
      allow read, write: if eu(uid);

      /* amigos: o dono manda no que é seu. A exceção que faz o
         pedido de amizade funcionar: outra pessoa pode escrever a
         aresta cujo ID É O UID DELA. Ou seja, dá pra criar um
         vínculo que aponta pra si mesmo, nunca pra terceiros —
         então ninguém "adiciona" duas pessoas uma na outra. */
      match /amigos/{outro} {
        allow read: if eu(uid);
        allow create, update: if eu(uid)
                              || (eu(outro) && campos().uid == request.auth.uid);
        allow delete: if eu(uid) || eu(outro);
      }

      /* salas: onde a pessoa já jogou. Privado — a lista de onde você
         anda não é assunto de mais ninguém. Quem está NA sala se lê em
         salas/{codigo}/jogadores, que é público pra quem tem conta. */
      match /salas/{codigo} {
        allow read, write: if eu(uid);
      }

      /* partidas: histórico imutável do jogador. Sem Cloud Function
         (ver LIMITE CONHECIDO), o dono cria a PRÓPRIA — mas só se
         bater com salas/{sala}/hist/registro (só o host escreve
         aquilo) e a fórmula de saldo/aproveitamento conferir de
         verdade. Create-only: nunca dá pra reescrever uma vez gravada,
         então nem uma escrita validada dá pra repetir e inflar. */
      match /partidas/{pid} {
        allow read: if eu(uid);
        allow create: if eu(uid)
                      && campos().pid == pid
                      && campos().sala is string
                      && campos().n is int && campos().n >= 2
                      && campos().posicao is int && campos().posicao >= 1 && campos().posicao <= campos().n
                      && campos().idxResultado is int
                      && campos().saldo == campos().n - 2 * campos().posicao + 1
                      && campos().aproveitamento is number
                      && campos().aproveitamento >= (campos().n - campos().posicao) / (campos().n - 1.0) - 0.0001
                      && campos().aproveitamento <= (campos().n - campos().posicao) / (campos().n - 1.0) + 0.0001
                      && resultadoBateComHist(campos().sala, pid, uid, campos().n, campos().posicao, campos().idxResultado);
        allow update, delete: if false;
      }
    }

    /* ---------------------------------------------------------
       nicks/{chave} — índice de unicidade E login por nick.

       LEITURA PÚBLICA DE PROPÓSITO, sem exigir login: é o que permite
       o cliente resolver nick -> e-mail e chamar
       signInWithEmailAndPassword direto, sem Cloud Function (que
       exigiria o projeto no plano Blaze). O preço, aceito
       conscientemente pelo dono: o e-mail de qualquer conta fica
       visível pra quem souber o nick dela, mesmo sem ter conta —
       aceitável aqui porque é um jogo pra jogar com amigos, não um
       produto público com estranhos. Escrita continua só do dono. */
    match /nicks/{chave} {
      allow read: if true;
      allow create: if logado() && campos().uid == request.auth.uid
                    && campos().chave == chave;
      allow update: if logado() && existia() && anterior().uid == request.auth.uid
                    && campos().uid == request.auth.uid;
      allow delete: if logado() && existia() && anterior().uid == request.auth.uid;
    }

    /* ---------------------------------------------------------
       ids/{id} — índice do ID de jogador, o handle que não muda.
       Legível por quem está logado: é assim que alguém te acha pra
       adicionar. Só o dono reserva, e o campo uid tem que ser o dele —
       senão daria pra apontar um ID pro perfil de outra pessoa.
       --------------------------------------------------------- */
    match /ids/{id} {
      allow read: if logado();
      allow create: if logado() && campos().uid == request.auth.uid
                    && campos().id == id;
      allow update: if logado() && existia() && anterior().uid == request.auth.uid
                    && campos().uid == request.auth.uid;
      allow delete: if logado() && existia() && anterior().uid == request.auth.uid;
    }

    /* ---------------------------------------------------------
       contadores/{chave} — contador atômico do ID de jogador
       (contadores/id). Qualquer logado pode ler e avançar — é o que
       um cadastro novo precisa fazer. O que a regra impede é andar
       PRA TRÁS: só aceita um `n` inteiro, não-negativo, e maior que o
       valor anterior. Um logado mal-intencionado consegue queimar
       números à toa (nunca usá-los), mas não forjar nem reaproveitar
       um ID já emitido — resíduo aceito, mesmo padrão de "quem pode
       fazer o mínimo de estrago" usado em _locks.
       --------------------------------------------------------- */
    match /contadores/{chave} {
      allow read: if logado();
      allow create: if logado() && campos().n is int && campos().n >= 0;
      allow update: if logado() && existia()
                    && campos().n is int && campos().n > anterior().n;
    }

    /* ---------------------------------------------------------
       _locks/{chave} — leases do acquire() do adaptador.
       Só ganha o lease quem: assina com o próprio uid, e encontra o
       lease livre, vencido ou já dele. O teto de 10 min no expiresAt
       impede que alguém escreva uma data no ano 3000 e sente em cima
       de um nick ou código de sala pra sempre.
       --------------------------------------------------------- */
    match /_locks/{chave} {
      allow read: if logado();
      allow write: if logado()
                   && campos().holder == request.auth.uid
                   && campos().expiresAt is int
                   && campos().expiresAt <= agora() + 600000
                   && (!existia()
                       || anterior().expiresAt <= agora()
                       || anterior().holder == request.auth.uid);
    }

    /* ---------------------------------------------------------
       cartas/{slug} — agregado de dificuldade (item 8). Cliente
       escreve direto, sem Cloud Function: ao contrário do saldo do
       rank, não tem valor de trapaça — só ajuda a recalibrar quem é
       fácil/médio/difícil no baralho. A trava aqui não é "impedir
       fraude", é impedir que um bug em duas abas ao mesmo tempo
       destrua o agregado: contagem só sobe de 1 em 1, soma só sobe
       entre 0 e 5 (uma nota válida) por escrita — nunca desce, nunca
       zera. Mesmo espírito do contador de ID em contadores/{chave}. */
    match /cartas/{slug} {
      allow read: if logado();
      allow create: if logado()
                    && campos().soma is int && campos().soma >= 0 && campos().soma <= 5
                    && campos().contagem == 1;
      allow update: if logado() && existia()
                    && campos().contagem == anterior().contagem + 1
                    && campos().soma >= anterior().soma
                    && campos().soma <= anterior().soma + 5;
      allow delete: if false;

      /* um voto por pessoa por partida: o ID do doc é uid_pid, e só
         quem é dono do uid cria o próprio. Nunca dá pra reescrever
         (update/delete falsos) — vota errado, vive com isso; é só
         uma nota de dificuldade, não o placar.

         Sem leitura: o cliente não confere "já votei?" antes de
         escrever (isso exigiria permissão de ler um doc que talvez
         nem exista — resource null trava a regra). Ele tenta criar
         direto e trata a negação (doc já existe -> vira update,
         update é sempre false) como "já votou, segue o jogo". */
      match /votos/{votoId} {
        allow read: if false;
        allow create: if eu(campos().uid)
                      && votoId == (campos().uid + "_" + campos().pid)
                      && campos().nota is int && campos().nota >= 0 && campos().nota <= 5;
        allow update, delete: if false;
      }
    }

    /* ---------------------------------------------------------
       salas/{codigo} — estado ao vivo da mesa.

       ⚠️  DEPENDE da migração de meuId -> auth.uid descrita no topo.
       Enquanto os jogadores forem identificados por uuid de aparelho,
       `eu(id)` nunca casa e estas regras barram o jogo inteiro.
       --------------------------------------------------------- */
    match /salas/{codigo} {
      allow read: if logado();
      allow create: if logado() && campos().hostId == request.auth.uid;

      /* Configuração da sala é do host. Os campos de andamento da
         partida também — quem distribui as cartas é ele. */
      allow update: if logado() && existia() && anterior().hostId == request.auth.uid;
      allow delete: if logado() && existia() && anterior().hostId == request.auth.uid;

      /* Cada jogador escreve só o próprio documento: seu nick, se já
         revelou, quando acertou. Ninguém marca acerto por ninguém. */
      match /jogadores/{jid} {
        allow read: if logado();
        allow create, update: if eu(jid) || souHostDa(codigo);
        allow delete: if eu(jid) || souHostDa(codigo);
      }

      /* Histórico da sala: só o host grava (o código já garante isso
         com ehHost(); aqui vira regra de verdade). */
      match /hist/{doc} {
        allow read: if logado();
        allow write: if souHostDa(codigo);
      }
    }

    /* Nada mais existe. Sem esta linha, um caminho esquecido fica
       aberto por omissão. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/* ============================================================
   LIMITE CONHECIDO — o host da sala ainda dita o resultado

   Existiu uma Cloud Function `derivarRank` (Admin SDK, gatilho em
   `salas/{codigo}/hist/registro`) que fazia essa escrita por fora do
   cliente. Foi abandonada: o projeto ficou no plano Spark, e Functions
   exige Blaze. A opção escolhida — client-side com validação cruzada
   contra o hist da sala, ver `resultadoBateComHist` acima — é mais
   fraca que ter um servidor, mas ainda fecha o ataque óbvio: ninguém
   escreve `usuarios/{uid}/partidas/{pid}` nem soma em `perfis/{uid}`
   sem um resultado real correspondente gravado pelo host.

   O que ainda dá, exatamente como antes da função existir: quem é HOST
   de uma sala escreve o `hist` dela, e a regra confia nesse resultado.
   Um host mal-intencionado consegue forjar o rank dos participantes
   DAQUELA sala — não o próprio à toa, e só de quem esteve presente com
   ele. Fechar isso exigiria validar jogada a jogada (quem revelou
   quando, quem acertou a senha de quem), o que é bem mais código.

   Por que o residual é aceitável: continua sendo um jogo presencial
   entre amigos, e as partidas ficam imutáveis em
   `usuarios/{uid}/partidas` — dá pra auditar (`A.rankAmigos` lê o
   agregado; a subcoleção de partidas é a prova).
   ============================================================ */
